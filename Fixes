```javascript
// ===== INITIALIZATION =====
document.addEventListener('DOMContentLoaded', function() {
  // ---- SIMULATOR CONTROLS ----
  const simControls = ['simTemp', 'simNitrate', 'simPhosphate', 'simLight', 'simTime', 'simSalinitySlider'];
  simControls.forEach(id => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener('input', updateSimulator);
    }
  });

  // ---- GLOBAL SEARCH ----
  const searchInput = document.getElementById('globalSearch');
  if (searchInput) {
    searchInput.addEventListener('keyup', function(e) {
      if (e.key === 'Enter') {
        performSearch();
      }
    });
  }

  // ---- TRIGGER LEVELS ----
  const resourcesTab = document.getElementById('tab7');
  if (resourcesTab) {
    const checklist = resourcesTab.querySelector('.checklist-card');
    if (checklist) {
      const triggerDiv = document.createElement('div');
      triggerDiv.innerHTML = createTriggerLevelsReference();
      checklist.parentNode.insertBefore(triggerDiv, checklist.nextSibling);
    }
  }

  // ---- PROGRESS TRACKER ----
  updateProgressDisplay();

  // ---- TAB VIEW TRACKING ----
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', function() {
      const onclickAttr = this.getAttribute('onclick');
      if (onclickAttr) {
        const match = onclickAttr.match(/'([^']+)'/);
        if (match) {
          const tabId = match[1];
          setTimeout(() => {
            progressData.tabsViewed.add(tabId);
            saveProgress();
          }, 100);
        }
      }
    });
  });

  // ---- GLOSSARY ----
  renderGlossary('all', '');
  const glossarySearch = document.getElementById('glossarySearch');
  if (glossarySearch) {
    glossarySearch.addEventListener('input', searchGlossary);
  }

  // ---- SIMULATOR INIT ----
  updateSimulator();
});
```

