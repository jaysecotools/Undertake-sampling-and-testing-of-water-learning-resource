function downloadAllTemplates() {
  const types = ['data-sheet', 'risk-assessment', 'chain-of-custody', 'sampling-plan', 'equipment-checklist'];
  const names = {
    'data-sheet': 'Field_Data_Sheet',
    'risk-assessment': 'Risk_Assessment',
    'chain-of-custody': 'Chain_of_Custody',
    'sampling-plan': 'Sampling_Plan',
    'equipment-checklist': 'Equipment_Checklist'
  };

  // Download each template sequentially with a short delay
  types.forEach((type, index) => {
    setTimeout(() => {
      generateAndDownload(type);
    }, index * 300);
  });

  // Show a message
  const msg = document.createElement('div');
